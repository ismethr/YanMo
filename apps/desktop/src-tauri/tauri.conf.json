{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YanMo",
  "version": "0.3.0",
  "identifier": "app.yanmo.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "研墨 YanMo",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "YanMo contributors",
    "copyright": "© 2026 YanMo contributors · MIT OR Apache-2.0",
    "category": "Productivity",
    "shortDescription": "本地优先的 AI LaTeX 论文工作台",
    "longDescription": "研墨 YanMo：开源、本地优先的 LaTeX 论文写作与编译桌面应用。内置 Tectonic 编译、PDF 双向跳转、论文大纲、图表与文献管理、Pandoc 导出 Word，以及每一处修改都需确认的 AI 辅助。",
    "homepage": "https://yanmo.ink",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2QTZDMjA1QjNENjVGODIKUldTQ1g5YXpCY0ttdHVsVUJSVWwxZS8xN3RnVm9nWkY3Q01GNVVWemxmT3h6Y1FJMWVQbmJMWUsK",
      "endpoints": [
        "https://github.com/ismethr/YanMo/releases/latest/download/latest.json"
      ]
    }
  }
}
