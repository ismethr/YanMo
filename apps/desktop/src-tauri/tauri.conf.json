{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yanmo",
  "version": "0.1.0-alpha",
  "identifier": "app.yanmo.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "windows": [{ "title": "研墨 Yanmo", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "appimage", "deb"]
  }
}
